APP_URL=https://fortinet-rbac.internal
APP_SECRET=replace-with-a-long-random-value
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SQLITE_PATH=./data/app.db

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Local test users (created on first DB init if missing): helpdesk, telecom, fuel — same password as above.

# Use Admin → Active Directory connection to detect/test, or set manually:
AD_URL=ldaps://dc01.example.local:636
AD_BASE_DN=DC=example,DC=local
AD_DOMAIN=EXAMPLE
AD_USERNAME_ATTRIBUTE=sAMAccountName
AD_GROUP_ATTRIBUTE=memberOf
# Set false when LDAPS uses an internal/self-signed DC certificate (common in lab AD):
# AD_VERIFY_TLS=false
# AD_TEST_TIMEOUT_MS=8000

# FortiManager (recommended): one API key for all managed FortiGates (7.2.x).
# Create an API user on FortiManager and generate a REST API key, then set:
FORTIMANAGER_HOST=10.0.0.5
FORTIMANAGER_API_KEY=replace-with-fortimanager-api-key
# FORTIMANAGER_ADOM=           # optional; blank uses global /dvmdb/device list
# FORTIMANAGER_VERIFY_TLS=true
# FORTIMANAGER_API_TIMEOUT_MS=10000
# Devices imported per sync batch (default 25). Lower if reverse-proxy timeouts persist.
# FORTIMANAGER_SYNC_BATCH_SIZE=25

# Legacy direct FortiGate API (only if not using FortiManager):
# auto (default): ?access_token= then Bearer — FortiOS 7.2.x (80F prod) and 7.4+ (91G lab).
FORTINET_API_AUTH=auto
# FORTINET_API_AUTH=query
# FORTINET_API_AUTH=bearer
# FORTINET_API_VDOM=root
# FORTINET_API_PORT=9443
# FORTINET_API_TIMEOUT_MS=10000

# FortiGate-only (default): network ARP + DHCP. Optional:
# FORTINET_INTERFACE_MAC_PATH=/api/v2/monitor/network/arp
# FORTINET_LEARNED_DEVICE_INCLUDE_LEGACY=true
# FORTINET_ENABLE_SWITCH_CONTROLLER=true
# FortiSwitch port tables are queried by default for device finder / PoE (set false to disable).
# FORTINET_ENABLE_SWITCH_CONTROLLER=false
# FORTINET_DISABLE_SWITCH_CONTROLLER=true
# PoE reset path override (default tries poe-reset, poe/reset, switch-action). Body must include switch + port.
# FORTINET_POE_RESET_PATH=/api/v2/monitor/switch-controller/poe-reset

# Asset Identity Manager (cached device inventory)
# ASSET_RETENTION_DAYS=90
# ASSET_STALE_DAYS=7
# ASSET_SYNC_BATCH_SIZE=1
# ASSET_SYNC_CRON_SECRET=replace-with-long-random-secret
