APP_URL=http://localhost:3000
APP_SECRET=replace-with-a-long-random-value
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SQLITE_PATH=./data/app.db

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Local test users (auto-created on first run): helpdesk, telecom, fuel — same password.

# Active Directory — use Admin to detect/test, or set manually:
AD_URL=ldaps://dc01.example.local:636
AD_BASE_DN=DC=example,DC=local
AD_DOMAIN=EXAMPLE
AD_USERNAME_ATTRIBUTE=sAMAccountName
AD_GROUP_ATTRIBUTE=memberOf
# Set false when LDAPS fails with "unable to get issuer certificate" (internal/self-signed DC cert):
AD_VERIFY_TLS=false
# AD_TEST_TIMEOUT_MS=8000

# FortiManager (recommended for FortiGate access):
FORTIMANAGER_HOST=10.0.0.150
FORTIMANAGER_API_KEY=replace-with-fortimanager-api-key
# FORTIMANAGER_ADOM=
# FORTIMANAGER_VERIFY_TLS=false
# FORTIMANAGER_SYNC_BATCH_SIZE=25

FORTINET_API_AUTH=auto
FORTINET_API_PORT=9443
